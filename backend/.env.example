# Application
VENDORIQ_APP_NAME=VendorIQ
VENDORIQ_APP_ENVIRONMENT=development
VENDORIQ_DEBUG=true
VENDORIQ_API_V1_PREFIX=/api/v1

# PostgreSQL database: create the vendoriq database before running migrations.
VENDORIQ_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vendoriq

# Use a unique, high-entropy value (at least 32 characters in production).
VENDORIQ_JWT_SECRET_KEY=replace-with-a-long-random-secret-key-before-deployment
VENDORIQ_JWT_ALGORITHM=HS256
VENDORIQ_ACCESS_TOKEN_EXPIRE_MINUTES=30
VENDORIQ_REFRESH_TOKEN_EXPIRE_DAYS=7

# Includes `null` so frontend pages opened directly with file:// can call the API.
VENDORIQ_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null
VENDORIQ_PROCUREMENT_FINANCE_THRESHOLD=100000
